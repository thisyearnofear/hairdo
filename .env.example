# Get your Replicate API token at https://www.replicate.com/account
REPLICATE_API_TOKEN=

# Get your WalletConnect project ID at https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: Google Analytics tracking ID
NEXT_PUBLIC_GTAG_ID=

# Upstash Redis (preferred names — legacy KV_REST_API_* still read as fallback)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Deployment track (post-Lisk shutdown 2 Nov 2026).
# Values: base-sepolia (default) | base | celo-sepolia | celo | arbitrum-sepolia | arbitrum-one
NEXT_PUBLIC_CHAIN=

# Protocol address for the active chain (or leave blank until redeployed)
NEXT_PUBLIC_PROTOCOL_ADDRESS=
# Per-chain overrides (only the entry matching NEXT_PUBLIC_CHAIN is used)
NEXT_PUBLIC_PROTOCOL_ADDRESS_84532=
NEXT_PUBLIC_PROTOCOL_ADDRESS_8453=
NEXT_PUBLIC_PROTOCOL_ADDRESS_11142220=
NEXT_PUBLIC_PROTOCOL_ADDRESS_42220=
NEXT_PUBLIC_PROTOCOL_ADDRESS_421614=
NEXT_PUBLIC_PROTOCOL_ADDRESS_42161=

# Deployer wallet for HairdoProtocol contract deployment (Base Sepolia testnet)
# Generate locally with: node -e "const v=require('viem/accounts');const pk=v.generatePrivateKey();const a=v.privateKeyToAccount(pk);console.log('PRIVATE_KEY='+pk);console.log('ADDRESS='+a.address)"
# NEVER commit your real key — keep it in .env.local (gitignored)
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
